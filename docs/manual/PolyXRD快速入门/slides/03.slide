<Slide style={{ width: 1280, height: 720, backgroundColor: '#FFFFFF', fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif", flexDirection: 'column' }}>
  <Box style={{ flexDirection: 'row', height: 120, paddingTop: 20, paddingLeft: 60, paddingRight: 60, alignItems: 'center', justifyContent: 'space-between' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
      <Box style={{ width: 52, height: 52, backgroundColor: '#2F8F4E', borderRadius: 10, alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
      </Box>
      <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0B3C6E' }}>装载数据</Text>
    </Box>
    <Text style={{ fontSize: 16, color: '#8A94A6' }}>数据页 · 装载文件</Text>
  </Box>
  <Box style={{ flexDirection: 'row', height: 540, paddingLeft: 60 }}>
    <Box style={{ width: 660, justifyContent: 'center' }}>
      <Image src="assets/02_data_loaded.png" style={{ width: 640, height: 480, objectFit: 'contain', border: '1px solid #C5D5E8', borderRadius: 8 }} />
    </Box>
    <Box style={{ width: 500, paddingLeft: 40, paddingRight: 60, paddingTop: 40, flexDirection: 'column', gap: 20 }}>
      <Box style={{ backgroundColor: '#E8F0F8', borderRadius: 10, padding: 20 }}>
        <Text style={{ fontSize: 19, color: '#333333', lineHeight: 1.6 }}><span style={{ fontWeight: 'bold', color: '#0B3C6E' }}>操作：</span>数据页 → 「装载文件」→ 选择 .xy / .txt / .dat / .rdf 数据文件。</Text>
      </Box>
      <Box style={{ backgroundColor: '#E8F0F8', borderRadius: 10, padding: 20 }}>
        <Text style={{ fontSize: 19, color: '#333333', lineHeight: 1.6 }}><span style={{ fontWeight: 'bold', color: '#0B3C6E' }}>确认：</span>波长默认 Cu Kα1（1.5406 Å），与实验靶材不符时在「波长」下拉切换。</Text>
      </Box>
      <Box style={{ backgroundColor: '#FDF3E7', borderRadius: 10, padding: 20, border: '1px solid #D9822B' }}>
        <Text style={{ fontSize: 19, color: '#8A5A1A', lineHeight: 1.6 }}><span style={{ fontWeight: 'bold' }}>关键：</span>波长错了，找峰、鉴定、精修全部失真——装载后先核波长。</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 60, paddingRight: 60 }}>
    <Text style={{ fontSize: 14, color: '#8A94A6' }}>PolyXRD v0.15.0 快速入门</Text>
    <Text style={{ fontSize: 14, color: '#8A94A6' }}>03 / 8</Text>

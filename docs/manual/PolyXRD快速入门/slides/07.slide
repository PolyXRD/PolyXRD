    <Box style={{ width: 460, paddingLeft: 40, paddingTop: 40, flexDirection: 'column', gap: 16 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0B3C6E' }}>高频问题速查</Text>
      <Box style={{ backgroundColor: '#E8F0F8', borderRadius: 10, padding: 16 }}>
        <Text style={{ fontSize: 16.5, color: '#333333', lineHeight: 1.55 }}><span style={{ fontWeight: 'bold', color: '#2F8F4E' }}>外部引擎红灯</span><br />「数据库→外部程序」配置或「检测」路径。</Text>

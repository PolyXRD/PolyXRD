<Slide style={{ width: 1280, height: 720, backgroundColor: '#FFFFFF', fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif", flexDirection: 'column' }}>
  <Box style={{ flexDirection: 'row', height: 120, paddingTop: 20, paddingLeft: 60, paddingRight: 60, justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0B3C6E' }}>主界面与数据装载</Text>
    <Text style={{ fontSize: 16, color: '#8A94A6' }}>第一章 · 快速上手</Text>
  </Box>
  <Box style={{ flexDirection: 'row', height: 540 }}>
    <Box style={{ width: 440, paddingRight: 40, flexDirection: 'column', gap: 18 }}>
      <Text style={{ fontSize: 96, fontWeight: 'bold', color: '#2F8F4E' }}>3 页签</Text>
      <Text style={{ fontSize: 20, color: '#333333', lineHeight: 1.6 }}>主窗口由「数据」「物相」「精修报告」三个页签贯穿分析全流程，左侧谱图区、右侧参数区同步联动。</Text>
      <Box style={{ backgroundColor: '#E8F0F8', borderRadius: 10, padding: 20 }}>
        <Text style={{ fontSize: 18, color: '#0B3C6E', lineHeight: 1.6 }}><span style={{ fontWeight: 'bold' }}>装载文件：</span>支持 .xy / .txt / .dat / .rdf 等一维衍射数据，自动识别起止角与步长。</Text>
      </Box>
      <Box style={{ backgroundColor: '#FDF3E7', borderRadius: 10, padding: 20, border: '1px solid #D9822B' }}>
        <Text style={{ fontSize: 18, color: '#8A5A1A', lineHeight: 1.6 }}><span style={{ fontWeight: 'bold' }}>关键检查：</span>波长默认 Cu Kα1（1.5406 Å）。波长与实验不一致，后续找峰、鉴定、精修全部失真——装载后第一步先核波长。</Text>
      </Box>
    </Box>
    <Box style={{ width: 720, flexDirection: 'column', justifyContent: 'center' }}>
      <Image src="assets/02_data_loaded.png" style={{ width: 720, height: 500, objectFit: 'contain', border: '1px solid #C5D5E8', borderRadius: 8 }} />
    </Box>
  </Box>
  <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 60, paddingRight: 60 }}>
    <Text style={{ fontSize: 14, color: '#8A94A6' }}>PolyXRD v0.15.0 使用手册</Text>
    <Text style={{ fontSize: 14, color: '#8A94A6' }}>04 / 14</Text>
  </Box>
</Slide>

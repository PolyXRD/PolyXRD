<Slide style={{ width: 1280, height: 720, backgroundColor: '#FFFFFF', fontFamily: "'Source Han Sans SC','Microsoft YaHei',sans-serif", flexDirection: 'column' }}>
  <Box style={{ flexDirection: 'row', height: 120, paddingTop: 20, paddingLeft: 60, paddingRight: 60, justifyContent: 'space-between', alignItems: 'center' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#0B3C6E' }}>物相鉴定</Text>
    <Text style={{ fontSize: 16, color: '#8A94A6' }}>第一章 · 快速上手</Text>
  </Box>
  <Box style={{ flexDirection: 'column', height: 540, paddingLeft: 60, paddingRight: 60 }}>
    <Image src="assets/04_phase_identified.png" style={{ width: 1160, height: 300, objectFit: 'contain', border: '1px solid #C5D5E8', borderRadius: 8 }} />
    <Box style={{ flexDirection: 'row', gap: 24, marginTop: 24 }}>
      <Box style={{ width: 370, backgroundColor: '#E8F0F8', borderRadius: 10, padding: 20 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0B3C6E' }}>① 检索</Text>
        <Text style={{ fontSize: 18, color: '#333333', lineHeight: 1.6, marginTop: 8 }}>数据源选「内置库」，用峰位对 COD 无机物相库做全库检索。</Text>
      </Box>
      <Box style={{ width: 370, backgroundColor: '#E8F0F8', borderRadius: 10, padding: 20 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0B3C6E' }}>② 叠加比对</Text>
        <Text style={{ fontSize: 18, color: '#333333', lineHeight: 1.6, marginTop: 8 }}>按 FoM（品质因子）排序候选相，点选即叠加理论峰位核对对齐情况。</Text>
      </Box>
      <Box style={{ width: 370, backgroundColor: '#E8F0F8', borderRadius: 10, padding: 20 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0B3C6E' }}>③ 采纳</Text>
        <Text style={{ fontSize: 18, color: '#333333', lineHeight: 1.6, marginTop: 8 }}>点击「采纳」加入物相列表；混合物样品逐条采纳直至谱线基本对齐。</Text>
      </Box>
    </Box>
  </Box>
  <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 60, paddingRight: 60 }}>
    <Text style={{ fontSize: 14, color: '#8A94A6' }}>PolyXRD v0.15.0 使用手册</Text>
    <Text style={{ fontSize: 14, color: '#8A94A6' }}>06 / 14</Text>

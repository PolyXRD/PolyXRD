# 顶层 大型 7z 归档 (品牌资产原始素材)
*.7z

# 调试脚本 / 一次性临时脚本
_check.py
dbg*.py
dbg*.ps1
_dbg*.py
_dbg*.ps1
_*.py
# 注意: `_*.py` 会连 `__init__.py` 一起吞掉(下划线开头, 后缀 .py)。
# 曾经因此导致 src/polyxrd/services/refinement_engines/__init__.py 从未入库,
# 且 git status 不报错(被忽略)。必须显式放行包初始化文件。
!__init__.py
!**/__init__.py
# v4.1.1: build.bat 的构建步骤脚本必须入库（曾被 _*.py 静默吞掉，
# 导致 fresh clone 构建不出内置库/VERSION.txt/便携 extras）。
# 白名单必须放在 `_*.py` 之后，否则会被后续排除规则覆盖。
!scripts/_build_post.py
!scripts/_pyinst_collect.py
# v4.2.0: tests/_cif_old_ref.py（旧 COD sqlite 参考实现）随旧运行时删除，
# 白名单条目同时移除；_baseline_* 为开发机指标快照，不入库。
tests/_baseline_metrics.py
tests/_baseline_metrics.json


{
  "project": "PolyXRD",
  "version": "0.1.0",
  "description": "X射线衍射仪数据分析软件 - 物相分析与Rietveld结构精修",
  "architecture": "MVVM",
  "language": "Python 3.11+",
  "ui_framework": "PySide6 (Qt for Python)",
  "core_libraries": {
    "科学计算": ["numpy", "scipy"],
    "XRD分析": ["pymatgen", "powerxrd"],
    "Rietveld精修": ["GSAS-II (GSASIIscriptable)", "powerxrd", "内置简化引擎"],
    "GUI": ["PySide6", "matplotlib"],
    "数据处理": ["lmfit", "scipy.signal"]
  },
  "modules": [
    {
      "name": "models",
      "path": "src/polyxrd/models/",
      "files": [
        {
          "name": "xrd_data.py",
          "classes": ["XRDData", "BackgroundResult", "PeakFitResult"],
          "responsibility": "XRD数据封装，提供验证、转换、操作方法",
          "tests": ["tests/test_xrd_data.py"],
          "interfaces": [
            "XRDData(two_theta, intensity, wavelength, metadata)",
            "d_spacing property",
            "q_vector property",
            "normalize() -> XRDData",
            "crop(min, max) -> XRDData",
            "copy() -> XRDData",
            "to_dict() -> dict",
            "from_dict(dict) -> XRDData"
          ],
          "validation_rules": [
            "2θ和强度数组长度必须相等",
            "数据点数量 >= 3",
            "起始2θ在[0, 180)范围内",
            "结束2θ在(0, 180]范围内"
          ]
        },
        {
          "name": "peak.py",
          "classes": ["Peak", "PeakList"],
          "responsibility": "衍射峰数据结构，支持序列化",
          "interfaces": [
            "Peak(two_theta, intensity, fwhm, hkl, d_spacing, phase)",
            "hkl_str property",
            "to_dict() -> dict",
            "from_dict(dict) -> Peak",
            "PeakList.peaks",
            "PeakList.add(peak)",
            "PeakList.sort_by_two_theta()",
            "PeakList.get_by_phase(name) -> list[Peak]",
            "PeakList.export_csv(path)"
          ]
        },
        {
          "name": "phase.py",
          "classes": ["LatticeParams", "Phase", "PhaseMatchResult"],
          "responsibility": "晶相/物相数据结构",
          "interfaces": [
            "LatticeParams(a, b, c, alpha, beta, gamma)",
            "LatticeParams.volume property",
            "Phase(name, formula, lattice, reference_peaks, weight_fraction)",
            "Phase.get_reference_peaks() -> list",
            "PhaseMatchResult.coverage property"
          ]
        },
        {
          "name": "refinement.py",
          "classes": ["RefinementResult"],
          "responsibility": "Rietveld精修结果封装",
          "interfaces": [
            "RefinementResult(phases, wR, GOF, ...)",
            "quality_grade property",
            "summary() -> str",
            "to_dict() -> dict",
            "from_dict(dict) -> RefinementResult"
          ]
        }
      ]
    },
    {
      "name": "services",
      "path": "src/polyxrd/services/",
      "files": [
        {
          "name": "data_loader.py",
          "classes": ["DataLoader", "save_xy"],
          "responsibility": "多格式XRD数据加载",
          "supported_formats": [".xy", ".dat", ".csv", ".txt", ".xrdml", ".raw", ".brml"],
          "interfaces": [
            "DataLoader.load(file_path, wavelength) -> XRDData",
            "save_xy(data, path, fmt) -> None"
          ],
          "tests": ["tests/test_data_loader.py"]
        },
        {
          "name": "data_preprocessor.py",
          "classes": ["DataPreprocessor"],
          "responsibility": "背景扣除、平滑、Kα2剥离",
          "methods": {
            "背景扣除": ["snip", "als", "polyfit", "median", "rolling"],
            "平滑": ["savgol", "gaussian", "moving", "median"]
          },
          "interfaces": [
            "subtract_background(data, method, **kwargs) -> BackgroundResult",
            "smooth(data, method, window, **kwargs) -> XRDData",
            "strip_ka_alpha2(data, wl_a1, wl_a2, ratio) -> XRDData"
          ],
          "tests": ["tests/test_preprocessor.py"]
        },
        {
          "name": "peak_finder.py",
          "classes": ["PeakFinder"],
          "responsibility": "自动峰检测和峰形拟合",
          "peak_models": ["gaussian", "lorentzian", "voigt", "pseudo_voigt"],
          "interfaces": [
            "find_peaks(data, height, distance, prominence) -> PeakList",
            "fit_peaks(data, peaks, model) -> (PeakList, stats)"
          ],
          "tests": ["tests/test_peak_finder.py"]
        },
        {
          "name": "phase_identifier.py",
          "classes": ["PhaseIdentifier"],
          "responsibility": "基于峰匹配的物相识别",
          "built_in_phases": 8,
          "interfaces": [
            "identify(data, peaks, elements, top_n, tolerance) -> list[PhaseMatchResult]",
            "add_phase(phase) -> None",
            "load_custom_database(path) -> None"
          ],
          "tests": ["tests/test_phase_identifier.py"]
        },
        {
          "name": "rietveld_refiner.py",
          "classes": ["RietveldRefiner"],
          "responsibility": "Rietveld结构精修（多引擎支持）",
          "engines": ["gsas2", "powerxrd", "builtin"],
          "interfaces": [
            "refine(data, phases, strategy, engine, max_cycles) -> RefinementResult"
          ],
          "tests": ["tests/test_rietveld.py"]
        }
      ]
    },
    {
      "name": "viewmodels",
      "path": "src/polyxrd/viewmodels/",
      "files": [
        {
          "name": "main_vm.py",
          "classes": ["MainViewModel"],
          "signals": ["status_changed", "error_occurred", "data_changed", "peaks_changed", "phase_identified", "refinement_completed"],
          "methods": ["load_file", "subtract_background", "smooth_data", "find_peaks", "fit_peaks", "identify_phases", "refine_structure", "export_result"]
        },
        {
          "name": "data_vm.py",
          "classes": ["DataViewModel"],
          "signals": ["data_loaded", "data_updated", "background_subtracted", "error"]
        },
        {
          "name": "phase_vm.py",
          "classes": ["PhaseViewModel"],
          "signals": ["peaks_detected", "peaks_fitted", "phase_identified", "phase_selected", "error"]
        },
        {
          "name": "refinement_vm.py",
          "classes": ["RefinementViewModel"],
          "signals": ["refinement_started", "refinement_progress", "refinement_completed", "refinement_failed", "error"]
        }
      ]
    },
    {
      "name": "views",
      "path": "src/polyxrd/views/",
      "files": [
        {
          "name": "main_window.py",
          "classes": ["MainWindow"],
          "layout": "多标签页 + 停靠窗口",
          "tabs": ["数据", "物相分析", "结构精修", "报告"]
        },
        {
          "name": "widgets/plot_widget.py",
          "classes": ["PlotWidget"],
          "features": ["交互式绘图", "峰标注", "残差图", "坐标信息", "图片导出"]
        },
        {
          "name": "widgets/peak_table.py",
          "classes": ["PeakTable"],
          "features": ["峰列表表格", "排序", "编辑", "CSV导出"]
        }
      ]
    },
    {
      "name": "utils",
      "path": "src/polyxrd/utils/",
      "files": [
        {
          "name": "math_utils.py",
          "functions": ["two_theta_to_d", "d_to_two_theta", "two_theta_to_q", "scherrer_formula", "williamson_hall", "lattice_volume", "gaussian", "lorentzian", "voigt"]
        },
        {
          "name": "validators.py",
          "functions": ["validate_wavelength", "validate_two_theta_range", "validate_lattice_params", "validate_peak_params"]
        },
        {
          "name": "file_utils.py",
          "functions": ["detect_xrd_format", "save_json", "load_json", "ensure_dir"]
        }
      ],
      "tests": ["tests/test_math_utils.py"]
    }
  ],
  "implementation_specs": {
    "data_models": {
      "language": "Python dataclasses",
      "validation": "__post_init__ 自动验证",
      "serialization": "to_dict()/from_dict() 对称方法",
      "mutability": "不可变模式: 返回新副本而非修改原对象"
    },
    "services": {
      "architecture": "无状态服务类，每个方法接收数据、返回结果",
      "error_handling": "抛出具体异常类型 (ValueError, FileNotFoundError)",
      "type_hints": "完整类型注解"
    },
    "viewmodels": {
      "pattern": "MVVM - View通过信号连接ViewModel",
      "signals": "PySide6 Signal",
      "threading": "QThreadPool用于耗时操作"
    }
  },
  "testing": {
    "framework": "pytest",
    "coverage_target": "核心模块 > 80%",
    "test_types": [
      "单元测试 (模型、服务)",
      "集成测试 (数据加载→处理→分析流程)",
      "边界条件测试",
      "错误处理测试"
    ],
    "run_command": "pytest tests/ -v",
    "coverage_command": "pytest tests/ --cov=polyxrd"
  },
  "reusable_libraries": {
    "GSAS-II": {
      "purpose": "专业Rietveld精修",
      "integration": "GSASIIscriptable API",
      "license": "Free for non-commercial",
      "url": "https://gsas-ii.org"
    },
    "powerxrd": {
      "purpose": "Python实现的XRD分析",
      "integration": "直接import使用",
      "license": "MIT",
      "url": "https://github.com/sohnyra/powerxrd"
    },
    "pymatgen": {
      "purpose": "晶体结构处理",
      "integration": "直接import使用",
      "license": "BSD",
      "url": "https://pymatgen.org"
    }
  }
}
